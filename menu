local JoystickThumb = Instance.new("Frame")
JoystickThumb.Name = "Thumb"
JoystickThumb.Size = UDim2.new(0, 45, 0, 45)
JoystickThumb.Position = UDim2.new(0.5, -22.5, 0.5, -22.5)
JoystickThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
JoystickThumb.BackgroundTransparency = 0.2
JoystickThumb.Parent = JoystickBase

local ThumbCorner = Instance.new("UICorner")
ThumbCorner.CornerRadius = UDim.new(1, 0)
ThumbCorner.Parent = JoystickThumb

local isDragging = false
local moveDirectionVector = Vector2.zero

local function stopJoystickMovement()
    isDragging = false
    moveDirectionVector = Vector2.zero
    JoystickThumb.Position = UDim2.new(0.5, -22.5, 0.5, -22.5)
    
    if LocalPlayer.Character then
        local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
        end
    end
end

local function updateJoystick(input)
    if not JoystickBase.Visible then return end
    if workspace.CurrentCamera and input.Position.X > workspace.CurrentCamera.ViewportSize.X / 2 then return end

    isDragging = true
    local center = JoystickBase.AbsolutePosition + (JoystickBase.AbsoluteSize / 2)
    local inputPos = Vector2.new(input.Position.X, input.Position.Y)
    local delta = inputPos - center
    local radius = JoystickBase.AbsoluteSize.X / 2
    local clampedDelta = delta.Magnitude > radius and (delta.Unit * radius) or delta
    
    JoystickThumb.Position = UDim2.new(0.5, clampedDelta.X - 22.5, 0.5, clampedDelta.Y - 22.5)
    moveDirectionVector = Vector2.new(clampedDelta.X / radius, clampedDelta.Y / radius)
end

game:GetService("UserInputService").InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        updateJoystick(input)
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if JoystickBase.Visible then
            updateJoystick(input)
        end
    end
end)

game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        stopJoystickMovement()
    end
end)

RunService.RenderStepped:Connect(function()
    if JoystickBase.Visible and isDragging and moveDirectionVector.Magnitude > 0.05 and LocalPlayer.Character then
        local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local speed = 16
            local forward = rootPart.CFrame.LookVector
            local right = rootPart.CFrame.RightVector
            
            local flatForward = Vector3.new(forward.X, 0, forward.Z).Unit
            local flatRight = Vector3.new(right.X, 0, right.Z).Unit
            
            local moveVel = (flatForward * (-moveDirectionVector.Y) + flatRight * moveDirectionVector.X) * speed
            rootPart.AssemblyLinearVelocity = Vector3.new(moveVel.X, rootPart.AssemblyLinearVelocity.Y, moveVel.Z)
        end
    end
end)

