-- LOGIC KỸ NĂNG, ANIMATION VÀ PHASE 2 / PHASE 3
---------------------------------------------------------
local isSwinging = false
local isTeapotThrowing = false
local phase2Triggered = false
local phase3Triggered = false
local isChangingPhase = false

local SWING_ANIM_ID = "99881191150215"
local LOW_HP_SWING_ID = "74660250225424"
local TEAPOT_ANIM_ID = "126991906303498"
local PHASE2_ANIM_ID = "117666725557838"
local PHASE3_TRANS_ID = "110754291756171"
local LOW_HP_IDLE_WALK_ID = "117666725557838"

local function playCustomAnimation(animator, targetId, speedMultiplier)
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. targetId
    local track = animator:LoadAnimation(anim)
    track:Play()
    track:AdjustSpeed(speedMultiplier or 1.0)
    return track
end

-- Hàm tạo vụ nổ nhỏ hoàn toàn không gây sát thương khi vòng sáng Halo biến mất
local function createHarmlessExplosion(character)
    local head = character:FindFirstChild("Head")
    if not head then return end

    -- Hiệu ứng khói / tia lửa ảo (không dùng đối tượng Explosion gây damage của Roblox)
    local part = Instance.new("Part")
    part.Size = Vector3.new(0.5, 0.5, 0.5)
    part.CFrame = head.CFrame
    part.Transparency = 1
    part.Anchored = true
    part.CanCollide = false
    part.Parent = workspace

    local emitter = Instance.new("ParticleEmitter")
    emitter.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 220, 255))
    emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 2.5)})
    emitter.Texture = "rbxassetid://1084991215" -- Particle khói sáng
    emitter.Lifetime = NumberRange.new(0.3, 0.6)
    emitter.Rate = 100
    emitter.Speed = NumberRange.new(10, 20)
    emitter.SpreadAngle = Vector2.new(180, 180)
    emitter.Parent = part

    emitter:Emit(30) -- Phát ra 30 hạt lửa/khói nhỏ một lần duy nhất

    task.delay(1.0, function()
        part:Destroy()
    end)
end

-- Gỡ bỏ Halo và kích hoạt hiệu ứng vụ nổ không gây damge
local function removeHalo(character)
    local halo = character:FindFirstChild("AngelHaloVisual")
    if halo then
        createHarmlessExplosion(character)
        halo:Destroy()
    end
end

local function applyLowHpAnimations(character)
    removeHalo(character)
    local animateScript = character:FindFirstChild("Animate")
    if animateScript then
        local idle = animateScript:FindFirstChild("idle")
        if idle then
            local anim1 = idle:FindFirstChild("Animation1")
            local anim2 = idle:FindFirstChild("Animation2")
            if anim1 then anim1.AnimationId = "rbxassetid://" .. LOW_HP_IDLE_WALK_ID end
            if anim2 then anim2.AnimationId = "rbxassetid://" .. LOW_HP_IDLE_WALK_ID end
        end
        local walk = animateScript:FindFirstChild("walk")
        if walk then
            local walkAnim = walk:FindFirstChild("WalkAnim")
            if walkAnim then walkAnim.AnimationId = "rbxassetid://" .. LOW_HP_IDLE_WALK_ID end
        end
    end
end

local function setupAnimationListener(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    local animator = humanoid:WaitForChild("Animator", 5)
    if not animator then return end

    humanoid.HealthChanged:Connect(function(health)
        local maxHealth = humanoid.MaxHealth
        local hpPercent = health / maxHealth

        -- Phase 2 (50% máu): Giữ nguyên chuẩn chiêu swing cũ
        if not phase2Triggered and hpPercent <= 0.5 and hpPercent > 0.2 then
            phase2Triggered = true
            isChangingPhase = true
            
            local phaseTrack = playCustomAnimation(animator, PHASE2_ANIM_ID, 1.5)
            phaseTrack.Stopped:Connect(function()
                isChangingPhase = false
            end)
            
        -- Phase 3 (20% máu): Xóa halo + nổ không damge + đổi animation đứng/chạy
        elseif not phase3Triggered and hpPercent <= 0.2 then
            phase3Triggered = true
            isChangingPhase = true
            applyLowHpAnimations(character)
            
            local phaseTrack = playCustomAnimation(animator, PHASE3_TRANS_ID, 1.5)
            phaseTrack.Stopped:Connect(function()
                isChangingPhase = false
            end)
        end
    end)

    animator.AnimationPlayed:Connect(function(track)
        if isChangingPhase then return end

        local anim = track.Animation
        if anim then
            local currentId = anim.AnimationId
            local hpPercent = (humanoid.Health / humanoid.MaxHealth)
            local isLowHp = hpPercent <= 0.5

            if isLowHp and (string.find(currentId, SWING_ANIM_ID) or string.find(currentId, LOW_HP_SWING_ID)) then
                if not isSwinging then
                    isSwinging = true
                    track:Stop(0)

                    playCustomAnimation(animator, LOW_HP_SWING_ID, 2.2)

                    local RootPart = character:FindFirstChild("HumanoidRootPart")
                    if RootPart then
                        local draggingForce = Instance.new("LinearVelocity")
                        draggingForce.MaxForce = 5000
                        draggingForce.VectorVelocity = Vector3.new(0, 0, 0)
                        draggingForce.Attachment0 = Instance.new("Attachment", RootPart)
                        draggingForce.Parent = RootPart

                        task.delay(2.28, function()
                            if draggingForce then draggingForce:Destroy() end
                            if not RootPart or not RootPart.Parent then isSwinging = false return end

                            local flyUp = Instance.new("LinearVelocity")
                            local attachment = Instance.new("Attachment", RootPart)
                            flyUp.Attachment0 = attachment
                            flyUp.MaxForce = 999999
                            flyUp.VectorVelocity = Vector3.new(0, 75, 0)
                            flyUp.Parent = RootPart

                            task.delay(0.25, function()
                                if flyUp then flyUp:Destroy() end
                                
                                local slamDown = Instance.new("LinearVelocity")
                                slamDown.Attachment0 = attachment
                                slamDown.MaxForce = 999999
                                slamDown.VectorVelocity = Vector3.new(0, -120, 0)
                                slamDown.Parent = RootPart

                                task.wait(0.15)
                                if slamDown then slamDown:Destroy() end
                                if attachment then attachment:Destroy() end
                                
                                -- Đẩy lại sau khi slamDown xong
                                local pushBack = Instance.new("LinearVelocity")
                                local attPush = Instance.new("Attachment", RootPart)
                                pushBack.Attachment0 = attPush
                                pushBack.MaxForce = 999999
                                pushBack.VectorVelocity = -RootPart.CFrame.LookVector * 40 + Vector3.new(0, 10, 0)
                                pushBack.Parent = RootPart
                                
                                task.wait(0.2)
                                if pushBack then pushBack:Destroy() end
                                if attPush then attPush:Destroy() end

                                -- Sau 5 giây, nếu HP <= 20% thì kích hoạt chuyển pha 3
                                if (humanoid.Health / humanoid.MaxHealth) <= 0.2 then
                                    task.delay(5.0, function()
                                        if character and humanoid and animator and not isChangingPhase then
                                            phase3Triggered = true
                                            isChangingPhase = true
                                            applyLowHpAnimations(character)
                                            
                                            local p3Track = playCustomAnimation(animator, PHASE3_TRANS_ID, 1.2)
                                            p3Track.Stopped:Connect(function()
                                                isChangingPhase = false
                                            end)
                                        end
                                    end)
                                end

                                isSwinging = false
                            end)
                        end)
                    else
                        isSwinging = false
                    end
                end

            elseif not isLowHp and string.find(currentId, SWING_ANIM_ID) then
                if not isSwinging then
                    isSwinging = true
                    playCustomAnimation(animator, SWING_ANIM_ID, 1.0)
                    JoystickBase.Visible = true
                    
                    task.delay(4, function()
                        JoystickBase.Visible = false
                        stopJoystickMovement()

                        local RootPart = character:FindFirstChild("HumanoidRootPart")
                        if RootPart then
                            local pushBack = Instance.new("LinearVelocity")
                            local att = Instance.new("Attachment", RootPart)
                            pushBack.Attachment0 = att
                            pushBack.MaxForce = 999999
                            pushBack.VectorVelocity = -RootPart.CFrame.LookVector * 40 + Vector3.new(0, 10, 0)
                            pushBack.Parent = RootPart
                            
                            task.wait(0.2)
                            if pushBack then pushBack:Destroy() end
                            if att then att:Destroy() end
                        end
                        isSwinging = false
                    end)
                end

            elseif string.find(currentId, TEAPOT_ANIM_ID) then
                if isTeapotThrowing then return end
                isTeapotThrowing = true

                local RootPart = character:FindFirstChild("HumanoidRootPart")
                if not RootPart then isTeapotThrowing = false return end

                local pushBack = Instance.new("LinearVelocity")
                local attachment = Instance.new("Attachment", RootPart)
                pushBack.Attachment0 = attachment
                pushBack.MaxForce = 999999
                pushBack.VectorVelocity = Vector3.new(-RootPart.CFrame.LookVector.X * 45, 0, -RootPart.CFrame.LookVector.Z * 45)
                pushBack.Parent = RootPart
                
                task.wait(0.2)
                if pushBack then pushBack:Destroy() end
                if attachment then attachment:Destroy() end

                track.Stopped:Connect(function()
                    local tpVelocity = Instance.new("LinearVelocity")
                    local tpAttachment = Instance.new("Attachment", RootPart)
                    tpVelocity.Attachment0 = tpAttachment
                    tpVelocity.MaxForce = 50000
                    tpVelocity.Parent = RootPart

                    local runConn
                    local elapsedTime = 0
                    local duration = 4.5

                    runConn = RunService.RenderStepped:Connect(function(dt)
                        elapsedTime = elapsedTime + dt
                        if elapsedTime <= duration then
                            if character and RootPart and humanoid and humanoid.MoveDirection.Magnitude > 0 then
                                local moveDir = humanoid.MoveDirection
                                tpVelocity.VectorVelocity = Vector3.new(moveDir.X * 12, tpVelocity.VectorVelocity.Y, moveDir.Z * 12)
                            else
                                tpVelocity.VectorVelocity = Vector3.new(0, 0, 0)
                            end
                        else
                            if runConn then runConn:Disconnect() end
                            if tpVelocity then tpVelocity:Destroy() end
                            if tpAttachment then tpAttachment:Destroy() end
                            isTeapotThrowing = false
                        end
                    end)
                end)
            end
        end
    end)
end

if LocalPlayer.Character then
    setupAnimationListener(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupAnimationListener)

